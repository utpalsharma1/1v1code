# Copy to .env and adjust. .env is gitignored.

# Matches docker-compose.yml. Dev credentials only — never reuse these.
DATABASE_URL="postgresql://1v1:1v1_dev_only@localhost:5432/1v1?schema=public"
REDIS_URL="redis://localhost:6379"

# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-me-generate-a-real-one"

# Judge
JUDGE_QUEUE="judge:jobs"
JUDGE_CONCURRENCY="4"
# Set to 1 to refuse to start unless every §11 containment flag is supported.
JUDGE_STRICT="1"
