# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Every variable the project reads is named here. Entry points refuse to start
# without the required ones rather than failing on first use — see
# scripts/lib/check.sh (shell) and @1v1/core/env (TypeScript).

# --- Required ---------------------------------------------------------------

# Matches docker-compose.yml. Dev credentials, bound to localhost, published on
# purpose so a clone runs. Never reuse them anywhere reachable.
DATABASE_URL="postgresql://1v1:1v1_dev_only@localhost:5432/1v1?schema=public"
REDIS_URL="redis://localhost:6379"

# 32+ random bytes, base64. NO DEFAULT IS PROVIDED ON PURPOSE — a shipped
# default session secret is a login-as-anyone bug that looks like configuration.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# --- Gateway ----------------------------------------------------------------

GATEWAY_PORT="4000"

# Comma-separated allowlist of browser origins that may open a socket. An entry
# may start with `*.` to match a hostname suffix — that exists only for
# Cloudflare quick tunnels, whose hostname is random and not knowable before
# cloudflared starts. On a real host this is one exact origin.
WEB_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:8180"

# --- Web --------------------------------------------------------------------

# EMPTY MEANS SAME ORIGIN, which is what every proxied deployment wants: the
# client connects to the page's own origin and derives wss:// from it. Set it
# only for local development with no reverse proxy in front.
NEXT_PUBLIC_GATEWAY_URL="http://localhost:4000"

# none | cloudflare | local. Which proxy, if any, is trusted to tell us the
# client's address. `none` is the safe default: an unverified header is an
# unlimited supply of rate-limit identities.
TRUSTED_PROXY="none"

# --- Judge ------------------------------------------------------------------

JUDGE_QUEUE="judge:jobs"
# Straight multiplier on worst-case memory: 256 MB per slot. Size against
# measured free memory, not core count.
JUDGE_CONCURRENCY="4"
# 1 = refuse to start unless every containment flag is supported.
JUDGE_STRICT="1"
