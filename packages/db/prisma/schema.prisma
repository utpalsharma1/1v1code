// 1v1.code — data model (Phase 2A)
//
// Ratings are integers on one shared scale for both players and problems (§8):
// a 1600 problem is one a 1600-rated player solves about half the time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ── Identity ─────────────────────────────────────────────────────────── */

model User {
  id           String   @id @default(cuid())
  handle       String   @unique
  /// Nullable because a guest (a challenge-link invitee who has not registered)
  /// is a real User row with no credentials. Postgres permits many NULLs in a
  /// unique index, so this stays unique for everyone who does have one.
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  /// Guests can play a challenge link unrated and nothing else (S7).
  isGuest        Boolean   @default(false)
  /// Guests are reaped after this; claiming the account clears it.
  guestExpiresAt DateTime?

  // Glicko-2. Rating is hidden behind the tier ladder (§8) but stored raw.
  rating       Int      @default(1200)
  ratingDev    Float    @default(350)
  volatility   Float    @default(0.06)
  placementsLeft Int    @default(5)

  sessions     Session[]
  submissions  Submission[]
  matchesAsP1  Match[]      @relation("MatchP1")
  matchesAsP2  Match[]      @relation("MatchP2")
  challengesHosted  Challenge[] @relation("ChallengeHost")
  challengesAccepted Challenge[] @relation("ChallengeGuest")
  ratingEvents RatingEvent[]

  @@index([rating])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/* ── Problems ─────────────────────────────────────────────────────────── */

enum Topic {
  DP
  GRAPHS
  GREEDY
  STRINGS
  MATH
}

model Problem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  topic       Topic
  statement   String
  /// Human-readable constraints, shown under the statement.
  constraints String

  /// On the player scale (§8). Seeded by estimate, then converged on solve data.
  rating      Int
  /// Glicko deviation for the problem, so convergence can be weighted.
  ratingDev   Float   @default(200)
  solveCount  Int     @default(0)
  attemptCount Int    @default(0)

  /// Key into the validator registry in src/validators.ts.
  ///
  /// The validator is deliberately NOT stored as source in the database.
  /// It has to execute server-side to police hack inputs (§6.8), and a row
  /// that contains executable code is a code-injection surface one bad admin
  /// form away from RCE. The key keeps the code in reviewed, typechecked
  /// source; the row only names it.
  validatorKey String

  /// §7 / the problem format: the I/O contract, without which a statement is a
  /// riddle rather than a problem. Required in the seed type and enforced by
  /// verify-seed.
  inputFormat   String @default("")
  outputFormat  String @default("")
  /// Why each sample produces its output — the part that teaches the format.
  note          String @default("")

  timeLimitMs   Int @default(5000)
  memoryLimitMb Int @default(256)

  testCases   TestCase[]
  submissions Submission[]
  matches     Match[]

  createdAt   DateTime @default(now())

  @@index([rating])
  @@index([topic])
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  ordinal   Int
  input     String
  expected  String
  /// Sample cases are shown in the statement; the rest are hidden.
  isSample  Boolean @default(false)

  @@unique([problemId, ordinal])
  @@index([problemId])
}

/* ── Execution ────────────────────────────────────────────────────────── */

enum Language {
  CPP17
  PYTHON3
}

enum Verdict {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  MEMORY_LIMIT
  RUNTIME_ERROR
  COMPILE_ERROR
  COMPILE_TIMEOUT
  COMPILE_MEMORY
  OUTPUT_LIMIT
  INTERNAL_ERROR
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)

  language  Language
  source    String
  verdict   Verdict  @default(PENDING)
  /// Index of the first failing test, null when accepted.
  failedAt  Int?
  passed    Int      @default(0)
  total     Int      @default(0)
  runtimeMs Int?
  memoryKb  Int?
  /// §6.9 RECEIPT ORDER. Stamped at the gateway the instant the submission
  /// arrives, on the monotonic clock, BEFORE the job is queued. This is the
  /// sole authority for who won and for the elapsed-time tiebreak.
  ///
  /// It is deliberately not createdAt: that is a wall-clock value, and the
  /// wall clock has been measured stepping backward 2514ms on this very host.
  /// It is also deliberately not the verdict time — the judge is a queue with
  /// finite slots, so verdict order is the queue's decision, not the players'.
  receiptMs BigInt?
  /// Diagnostics only. Never an input to the result (§6.9).
  queueWaitMs Int?
  judgeMs     Int?
  /// Compiler output on COMPILE_ERROR. Never the program's own stdout.
  message   String?

  createdAt DateTime @default(now())
  results   TestResult[]

  @@index([userId, createdAt])
  @@index([problemId])
  @@index([matchId])
}

model TestResult {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  ordinal   Int
  verdict   Verdict
  runtimeMs Int?
  memoryKb  Int?

  @@unique([submissionId, ordinal])
  @@index([submissionId])
}

/* ── Matches ──────────────────────────────────────────────────────────── */

enum MatchMode {
  RANKED
  BLITZ
  BO3
  CASUAL
}

enum MatchState {
  PENDING
  LIVE
  FINISHED
  ABANDONED
}

/// PUBLIC is listed in the live panel and watchable by code; UNLISTED is
/// watchable by code only. UNLISTED is NOT private - see S7.
enum MatchOutcomeKind {
  WIN
  DRAW
  CANCELED
  VOID
}

enum MatchVisibility {
  PUBLIC
  UNLISTED
}

enum MatchOrigin {
  MATCHMAKING
  CHALLENGE
  REMATCH
}

model Match {
  id        String     @id @default(cuid())
  mode      MatchMode  @default(RANKED)
  state     MatchState @default(PENDING)

  /// Spectator code: 10 Crockford-Base32 characters, generated from a CSPRNG
  /// exactly like a session token. NOT a cuid - the cuid lesson from the session
  /// table applies here too, and a walkable code makes UNLISTED meaningless.
  /// 32^10 = 1.13e15, so a random guess hits one of a million live matches with
  /// probability 8.9e-10. Unique constraint plus retry covers collisions.
  spectatorCode String  @unique
  visibility    MatchVisibility @default(PUBLIC)
  origin        MatchOrigin     @default(MATCHMAKING)
  /// Spectator delay in ms. 45000 for ranked and tournament (stream-sniping),
  /// 0 for challenge and custom unless the host raises it (S7).
  spectatorDelayMs Int @default(45000)

  /// Set when this match came from a challenge link, so its origin survives.
  challengeId String?    @unique
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  p1Id      String
  p1        User       @relation("MatchP1", fields: [p1Id], references: [id])
  p2Id      String
  p2        User       @relation("MatchP2", fields: [p2Id], references: [id])
  winnerId  String?

  problemId String
  problem   Problem    @relation(fields: [problemId], references: [id])

  startedAt  DateTime?
  finishedAt DateTime?
  /// How the match came to rest. CANCELED and VOID both mean "no rating
  /// change" and are still distinct: VOID is OUR failure (S6.9) and is meant
  /// to be rare and alarming, CANCELED is routine (nobody accepted, both
  /// disconnected). Collapsing them would make a real no-contest
  /// indistinguishable from an abandoned queue pop.
  outcomeKind   MatchOutcomeKind?
  outcomeReason String?
  /// Final elapsed time per side, in ms. The §6.8 hack penalty is charged here.
  p1ElapsedMs Int?
  p2ElapsedMs Int?

  submissions Submission[]
  ratingEvents RatingEvent[]
  replay      Replay?

  createdAt DateTime @default(now())

  @@index([p1Id])
  @@index([p2Id])
  @@index([state])
  @@index([visibility, state])
}

/// A challenge link (S7, Phase 2D). Created before an opponent exists, which is
/// the whole point: the link has to survive the other person not being online.
model Challenge {
  id       String   @id @default(cuid())
  /// Same alphabet and entropy as spectatorCode, and same reasoning.
  code     String   @unique
  hostId   String
  host     User     @relation("ChallengeHost", fields: [hostId], references: [id], onDelete: Cascade)

  mode           MatchMode       @default(CASUAL)
  visibility     MatchVisibility @default(UNLISTED)
  /// Target problem rating band, so the host can pick difficulty up front.
  ratingMin      Int             @default(800)
  ratingMax      Int             @default(2000)
  /// Whether an unregistered guest may accept. Unrated if so.
  allowGuest     Boolean         @default(true)

  /// A stale link must show something specific rather than 404 - see S7.
  expiresAt   DateTime
  consumedAt  DateTime?
  consumedById String?
  consumedBy  User?     @relation("ChallengeGuest", fields: [consumedById], references: [id], onDelete: SetNull)

  match     Match?
  createdAt DateTime @default(now())

  @@index([hostId])
  @@index([expiresAt])
}

model RatingEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  before    Int
  after     Int
  devBefore Float
  devAfter  Float
  createdAt DateTime @default(now())

  @@unique([userId, matchId])
  @@index([userId, createdAt])
}

/// Index only. The replay itself is the append-only JSONL event log on
/// disk/S3 (§10) — playback is a pure function of that file, and this row
/// just points at it.
model Replay {
  id        String   @id @default(cuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  logUri    String
  sizeBytes Int
  eventCount Int
  durationMs Int
  createdAt DateTime @default(now())
}
