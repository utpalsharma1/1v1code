{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    // The workspace packages ship source and are typechecked from here. They
    // use explicit .ts specifiers so bare Node (the judge worker, the seed and
    // verify scripts) can resolve them; a bundler is happy either way.
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    },
    "incremental": true
  },
  // `.next-build` is the production output directory — see next.config.ts. Both
  // are listed because dev and build deliberately no longer share one.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
