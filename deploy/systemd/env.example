# /etc/1v1/env — chmod 600, owned by root. Referenced by every unit.
#
# §13.9: every entry point states the variables it needs and REFUSES without
# them. This file is the single place they are set, so a service cannot start
# with a half-configured environment that happens to work from one shell.

# --- Identity of this deployment --------------------------------------------
SITE_HOSTNAME=1v1.example.eu.org
ACME_EMAIL=you@example.com
WEB_ORIGIN=https://1v1.example.eu.org
NODE_ENV=production

# --- Data -------------------------------------------------------------------
DATABASE_URL=postgresql://1v1:CHANGE_ME@127.0.0.1:5432/1v1
REDIS_URL=redis://127.0.0.1:6379

# --- No SESSION_SECRET, and that is not an omission -------------------------
# `.env` on the dev box has one and NOTHING READS IT. Sessions are opaque
# server-side rows keyed by a high-entropy random token (`createSession` in
# apps/web/lib/auth.ts), not signed cookies, so there is no secret to rotate.
# Carrying the variable here would be worse than useless: it would imply
# sessions depend on it, and somebody rotating it to invalidate every login
# would find that nothing happened. Same for JUDGE_QUEUE, which is dead config —
# the key is a constant exported from @1v1/proto.

# --- Absolute paths, because the working directory is NOT the repo ----------
# Found by running the path resolver the way systemd runs it (`cd / && env -i`):
# with no REPLAY_DIR and no workspace above the cwd, the old code invented
# `/var/replays`. It now refuses and names this variable. §10 makes the event
# log the replay, so losing it loses the match.
REPLAY_DIR=/var/lib/1v1/replays

# --- Ports ------------------------------------------------------------------
GATEWAY_PORT=4000
PORT=3001

# --- Trust ------------------------------------------------------------------
# `local`, NOT `cloudflare`. No tunnel sits in front at Stage 1, so
# CF-Connecting-IP will not be present and must never be trusted; Caddy
# overwrites X-Forwarded-For and that is the only sanitised source.
TRUSTED_PROXY=local

# --- Judge ------------------------------------------------------------------
# §11: concurrency is a straight multiplier on worst-case memory (256MB x slots).
# 2 slots = 512MB on a 24GB box is very conservative and deliberately so — the
# constraint is not memory, it is that a public judge is the cheapest thing to
# abuse. Raise it once there is real traffic to size against.
JUDGE_CONCURRENCY=2
JUDGE_STRICT=1
