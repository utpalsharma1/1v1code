{
  "name": "1v1-code",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "judge": "pnpm --filter @1v1/judge start",
    "judge:images": "pnpm --filter @1v1/judge images",
    "judge:test": "pnpm --filter @1v1/judge test",
    "db:push": "pnpm --filter @1v1/db push",
    "db:seed": "pnpm --filter @1v1/db seed",
    "db:verify": "pnpm --filter @1v1/db verify",
    "clean": "node -e \"['apps/web/.next','apps/web/.turbo','packages/ui/.turbo','.turbo','apps/web/tsconfig.tsbuildinfo'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}));console.log('cleaned')\"",
    "judge:reaper": "pnpm --filter @1v1/judge reaper",
    "db:users": "pnpm --filter @1v1/db seed:users",
    "gateway": "pnpm --filter @1v1/gateway start",
    "db:solutions": "pnpm --filter @1v1/db solutions",
    "test:signin": "pnpm --filter @1v1/gateway test:signin",
    "test:smoke": "pnpm --filter @1v1/web test:smoke"
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  }
}
